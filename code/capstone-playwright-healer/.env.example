# ---------------------------------------------------------------------------
# Provider configuration — see PROVIDERS.md at the repo root.
# Every project in this course reads these same four variables.
# ---------------------------------------------------------------------------

# Your provider's OpenAI-compatible endpoint. Pick one:
#   https://api.x.ai/v1                                    xAI (Grok)
#   https://api.groq.com/openai/v1                         Groq  (free tier)
#   http://localhost:11434/v1                              Ollama (local, free)
#   https://api.openai.com/v1                              OpenAI
#   https://generativelanguage.googleapis.com/v1beta/openai/   Google (free tier)
#   https://api.anthropic.com/v1/                          Anthropic
#   https://openrouter.ai/api/v1                           OpenRouter
LLM_BASE_URL=

# Key for THAT provider. Leave blank for Ollama.
LLM_API_KEY=

# Model ID. There is no default on purpose — open your provider's model list
# and paste a current one. Anything hardcoded here would be stale by the time
# you read it.
LLM_MODEL=

# Optional: a cheaper/faster model for high-volume steps. Defaults to LLM_MODEL.
LLM_MODEL_SMALL=

# Optional: USD per million tokens, from your provider's pricing page.
# Unset means the tools print token counts and skip the dollar figure.
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# ── Capstone settings ───────────────────────────────────────────────────────
# Confidence threshold (0–1). Proposals at or above this level are auto-applied.
# Proposals below it are written to .healer/ for human review.
HEAL_CONFIDENCE_THRESHOLD=0.7

# Optional — Langfuse observability (https://langfuse.com/)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
